{
  "enabled": true,
  "name": "Secret scan before commit",
  "description": "Before a commit, scan the staged changes for anything that looks like a secret (API keys, tokens, private keys, .env contents, cloud credentials). The app ships as a static site with no server and no account (NFR-2, NFR-3); nothing secret should ever enter the public repository. This hook is a safety net, not a licence to commit secrets.",
  "version": "1",
  "when": {
    "type": "preCommit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "A commit is about to be made. Read ONLY the files that are staged for this commit and scan them for likely secrets: private keys (BEGIN ... PRIVATE KEY), AWS/GCP/Azure access keys, bearer or OAuth tokens, long random API-key-looking strings, passwords, and the contents of .env / credential files. Report any match by file and key name, never printing the secret value itself. If you find a likely secret, tell me clearly to unstage it and stop before committing. If the staged changes look clean, say so in one line. Do not modify any file and do not run any command."
  }
}
